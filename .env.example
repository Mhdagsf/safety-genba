# ====================================================================
# KONFIGURASI DATABASE MYSQL - SAFETY GENBA PT. FUJISEAT INDONESIA
# ====================================================================

# --- OPSI 1: SERVER LOKAL (XAMPP / MySQL Lokal) ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=safety_genba
DB_SSL=false

# --- OPSI 2: HOSTING DI RENDER (TiDB Cloud / Aiven / Railway MySQL) ---
# Isi variabel di atas pada menu "Environment Variables" di Dashboard Render,
# ATAU cukup isi satu variabel DATABASE_URL seperti contoh di bawah:
# DATABASE_URL=mysql://user:password@gateway01.ap-southeast-1.prod.aws.tidbcloud.com:4000/safety_genba?ssl=true
# DB_SSL=true
